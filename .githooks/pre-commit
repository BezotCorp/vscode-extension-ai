#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
root="$PWD"

# Priorité à la version installée dans le projet.
if [[ -x "$root/node_modules/.bin/biome" ]]; then
    biome="$root/node_modules/.bin/biome"
    origin="local"
elif command -v biome >/dev/null 2>&1; then
    biome=$(command -v biome)
    origin="global"
else
    echo "Pre-commit : Biome introuvable (local et global)." >&2
    exit 1
fi

mapfile -d '' -t staged < <(
    git diff --cached --name-only -z --diff-filter=ACMR
)

((${#staged[@]})) || exit 0

# Le contenu temporaire reste en RAM.
if [[ ! -d /dev/shm || ! -w /dev/shm ]]; then
    echo "Pre-commit : /dev/shm indisponible." >&2
    exit 1
fi

tmp=$(mktemp -d /dev/shm/bezotcorp-hook.XXXXXXXX)
lock=""
lock_held=false

cleanup() {
    if $lock_held; then
        rm -f -- "$lock"
    fi
    rm -rf -- "$tmp"
}

trap cleanup EXIT

mkdir -p "$tmp/tree" "$tmp/index" "$tmp/working" "$tmp/restore"

index_path=$(git rev-parse --git-path index)
[[ "$index_path" = /* ]] || index_path="$root/$index_path"

[[ -f "$index_path" ]] || {
    echo "Pre-commit : index Git introuvable." >&2
    exit 1
}

cp -- "$index_path" "$tmp/original-index"
cp -- "$index_path" "$tmp/new-index"

declare -a paths=()
declare -a modes=()
declare -a partial=()
declare -a whitespace=()
declare -a biome_paths=()
declare -a rust_paths=()
declare -a sync_paths=()
declare -a sync_sources=()
declare -a sync_originals=()
declare -a preserved=()
declare -a corrected=()

# Même configuration que celle du dépôt.
# Si biome.json est indexé, utiliser sa version indexée.
if git diff --cached --name-only -- biome.json |
    grep -qx 'biome.json'; then
    git show :biome.json > "$tmp/tree/biome.json"
else
    cp -- "$root/biome.json" "$tmp/tree/biome.json"
fi

echo "Pre-commit : Biome $origin ($("$biome" --version))"

# -------------------------------------------------------
# 1. Un seul instantané de la sélection Git
# -------------------------------------------------------

for path in "${staged[@]}"; do
    case "$path" in
        package.nls.json|package.nls.*.json)
            continue
            ;;
        *.ts|*.tsx|*.js|*.jsx|*.json|*.jsonc|\
        *.css|*.scss|*.md|*.yaml|*.yml|*.rs)
            ;;
        *)
            continue
            ;;
    esac

    [[ -f "$path" && ! -L "$path" ]] || {
        echo "Fichier indisponible : $path" >&2
        exit 1
    }

    mode=$(
        git ls-files --stage -- "$path" |
        awk '$3 == 0 {print $1; exit}'
    )

    case "$mode" in
        100644|100755) ;;
        *)
            echo "Mode Git inattendu : $path" >&2
            exit 1
            ;;
    esac

    i=${#paths[@]}
    paths+=("$path")
    modes+=("$mode")

    git show ":$path" > "$tmp/index/$i"
    cp -- "$path" "$tmp/working/$i"

    is_partial=false
    is_whitespace=false

    if ! cmp -s "$tmp/index/$i" "$tmp/working/$i"; then
        is_partial=true

        if git diff -w --quiet -- "$path"; then
            is_whitespace=true
        fi
    fi

    partial+=("$is_partial")
    whitespace+=("$is_whitespace")

    destination="$tmp/tree/$path"
    mkdir -p -- "$(dirname "$destination")"

    # Les changements non indexés significatifs sont exclus.
    if $is_partial && $is_whitespace; then
        cp -- "$tmp/working/$i" "$destination"
    else
        cp -- "$tmp/index/$i" "$destination"

        if $is_partial; then
            preserved+=("$path")
        fi
    fi

    case "$path" in
        *.rs)
            rust_paths+=("$path")
            ;;
        *)
            biome_paths+=("$path")
            ;;
    esac
done

((${#paths[@]})) || {
    echo "Pre-commit : aucune source à traiter."
    exit 0
}

echo "Sources sélectionnées : ${#paths[@]}"
echo "Biome : ${#biome_paths[@]} fichier(s)"
echo "rustfmt : ${#rust_paths[@]} fichier(s)"

# -------------------------------------------------------
# 2. Biome en un seul processus
# -------------------------------------------------------

if ((${#biome_paths[@]})); then
    echo "Biome : corrections sûres et formatage..."

    (
        cd "$tmp/tree"

        "$biome" check --write \
            --config-path="$tmp/tree" \
            -- "${biome_paths[@]}"
    )
fi

# -------------------------------------------------------
# 3. rustfmt en un seul processus
# -------------------------------------------------------

if ((${#rust_paths[@]})); then
    echo "rustfmt : formatage Rust..."

    (
        cd "$tmp/tree"

        rustfmt \
            --edition 2024 \
            --config skip_children=true \
            -- "${rust_paths[@]}"
    )
fi

# -------------------------------------------------------
# 4. Comparaison et préparation du nouvel index
# -------------------------------------------------------

changes=0

for ((i=0; i<${#paths[@]}; i++)); do
    path="${paths[i]}"
    result="$tmp/tree/$path"

    if ! cmp -s "$path" "$tmp/working/$i"; then
        echo "Modification concurrente : $path" >&2
        exit 1
    fi

    if ! cmp -s "$tmp/index/$i" "$result"; then
        hash=$(git hash-object -w --stdin < "$result")

        GIT_INDEX_FILE="$tmp/new-index" \
            git update-index --add --cacheinfo \
            "${modes[i]},$hash,$path"

        corrected+=("$path")
        changes=$((changes + 1))
    fi

    # Synchroniser le fichier de travail uniquement
    # s'il ne contient aucun changement significatif
    # volontairement laissé hors du commit.
    if ! ${partial[i]} || ${whitespace[i]}; then
        if ! cmp -s "$tmp/working/$i" "$result"; then
            sync_paths+=("$path")
            sync_sources+=("$result")
            sync_originals+=("$tmp/working/$i")
        fi
    fi
done

# Éviter toute écriture inutile dans l'index.
if ((changes == 0)); then
    echo "Pre-commit : aucune correction nécessaire."
    exit 0
fi

if ! cmp -s "$index_path" "$tmp/original-index"; then
    echo "Index Git modifié pendant le traitement." >&2
    exit 1
fi

# -------------------------------------------------------
# 5. Synchronisation contrôlée
# -------------------------------------------------------

lock="$index_path.lock"

if ! (set -C; : > "$lock") 2>/dev/null; then
    echo "Index Git verrouillé." >&2
    exit 1
fi

lock_held=true

for ((i=0; i<${#sync_paths[@]}; i++)); do
    if ! cmp -s "${sync_paths[i]}" "${sync_originals[i]}"; then
        echo "Modification concurrente : ${sync_paths[i]}" >&2
        exit 1
    fi

    cp -p -- "${sync_paths[i]}" "$tmp/restore/$i"
done

restore_working() {
    for ((j=0; j<${#sync_paths[@]}; j++)); do
        cp -p -- "$tmp/restore/$j" "${sync_paths[j]}" || true
    done
}

for ((i=0; i<${#sync_paths[@]}; i++)); do
    if ! cp -- "${sync_sources[i]}" "${sync_paths[i]}"; then
        restore_working
        echo "Échec de synchronisation des fichiers." >&2
        exit 1
    fi
done

if ! cp -- "$tmp/new-index" "$lock"; then
    restore_working
    echo "Échec de préparation de l'index." >&2
    exit 1
fi

if ! mv -- "$lock" "$index_path"; then
    restore_working
    echo "Échec de publication de l'index." >&2
    exit 1
fi

lock_held=false

echo
echo "=== Pre-commit terminé ==="
echo "Sources analysées : ${#paths[@]}"
echo "Corrections indexées : ${#corrected[@]}"

if ((${#preserved[@]})); then
    echo "Modifications non indexées préservées :"
    printf '  - %s\n' "${preserved[@]}"
fi
